{
  "name": "ISL Engine",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r backend/requirements.txt pytest httpx",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "ISL app", "onAutoForward": "openBrowser" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
